{
  "expo": {
    "name": "turaneza",
    "slug": "turaneza",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "turaneza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ngewe.turaneza"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07283b",
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ngewe.turaneza",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#005ea4"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.747111378838-gl8hjfr88euvfqt2bf191rss5i26apm2"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "436e97a3-5430-4934-9e62-a63188f0bed1"
      }
    },
    "owner": "ngewe",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/436e97a3-5430-4934-9e62-a63188f0bed1"
    }
  }
}
