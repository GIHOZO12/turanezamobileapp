# Uncomment to point the app at the deployed backend instead of your local Django server.
# Restart Metro (not just reload) after changing this — Expo inlines EXPO_PUBLIC_* at build time.
 EXPO_PUBLIC_API_BASE_URL="https://backend-production-c0d92.up.railway.app"

# Google Sign-In OAuth client IDs (Google Cloud Console -> APIs & Services -> Credentials).
# Each platform needs its own client ID — Android's is tied to the app's package name +
# SHA-1 signing fingerprint, iOS's to the bundle identifier. webClientId is only used when
# running in a browser (Expo web), not by the native Android/iOS sign-in flow.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="747111378838-3pi0g6pcvoua3jiml3c0f78ia1q9o1i3.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="747111378838-gl8hjfr88euvfqt2bf191rss5i26apm2.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="747111378838-4pmo3a6ps4n53im2mh8lq3mq5hdbcqof.apps.googleusercontent.com"
